# ==============================================================================
# Lumina VE - Environment Configuration Sample
# ==============================================================================

# Application Environment: 'dev' or 'production'
# Setting to 'dev' allows testing internal/loopback IPs without triggering SSRF blocks
ENVIRONMENT=dev

# API Authentication Key
# Passed in the 'X-API-Key' header for protected endpoint authorization
LUMINA_API_KEY=dev_lumina_secure_key_2026

# Feature Toggles
# Set to 'false' to run in Lite Mode (skips rembg background removal & K-Means color matrix)
ENABLE_HEAVY_ML=true

# Memory & Performance Safeguards
# Minimum required container RAM (in MB) before heavy ML features dynamically skip to prevent OOM
MIN_RAM_REQUIRED_MB=400

# Network & Storage Limits
# Maximum duration (in seconds) to wait when streaming external image assets
FETCH_TIMEOUT_SECONDS=15

# Maximum allowed asset size in bytes (25 MB = 26214400)
MAX_FILE_SIZE_BYTES=26214400

# Server Port (Optional: Defaults to 8000 locally or uses $PORT injected by cloud providers)
PORT=8000